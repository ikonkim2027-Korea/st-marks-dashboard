# Copy this to `.env.local` and fill in the values. .env.local is gitignored.

# ---- Auth.js (admin sign-in via Google) -----------------------------------
# Generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth — see SETUP-ADMIN.md for the Google Cloud Console walkthrough
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Optional: weather hero -----------------------------------------------
# Without this the weather widget falls back to mock data.
OPENWEATHER_API_KEY=

# ---- Optional: air quality hero -------------------------------------------
# Without this the AQ chip is hidden. Get one at https://docs.airnowapi.org/
AIRNOW_API_KEY=
